ARG PYTHON_BASE_IMAGE=python:3.10-slim
FROM ${PYTHON_BASE_IMAGE}

ARG INSTALL_INFOBIP_CA=false
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    python3-dev \
    libsndfile1 \
    sox \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN if [ "$INSTALL_INFOBIP_CA" = "true" ]; then \
      curl -fsSL http://ca.infobip.com/crl/RootCA.crt -o /usr/local/share/ca-certificates/infobip-rootca.crt && \
      update-ca-certificates; \
    fi

WORKDIR /app

# Copy requirements and install
COPY requirements.txt .
# faster-whisper uses CTranslate2 which has CPU support built-in (no PyTorch needed)
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir "numpy<2.0.0" setuptools wheel typing_extensions && \
    pip3 install --no-cache-dir -r requirements.txt

# Copy application
COPY main.py .

# Create models directory
RUN mkdir -p /app/models

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["python3", "main.py"]
